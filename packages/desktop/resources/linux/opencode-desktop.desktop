[Desktop Entry]
Name=Zaino AI Agent
# The Exec value is quoted: the install path contains a space ("Zaino AI Agent"), and an
# unquoted Exec is split on whitespace by the launcher, which drops the arguments onto the path
# and starts nothing. Every generated entry quotes for the same reason.
Exec="/opt/Zaino AI Agent/ai.zaino.desktop" %U
Terminal=false
Type=Application
Icon=ai.zaino.desktop
StartupWMClass=ai.zaino.desktop
NoDisplay=true
Comment=Zaino AI Agent — desktop client for the Zaino Gateway
Categories=Development;
